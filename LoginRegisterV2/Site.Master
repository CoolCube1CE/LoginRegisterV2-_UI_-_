<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="LoginRegisterV2.SiteMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Beverage Store Management System</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script>
        // Runs immediately, before the page paints, so there's no flash of the wrong theme
        (function () {
            var theme = localStorage.getItem('theme') || 'light';
            document.documentElement.className = theme === 'dark' ? 'dark-theme' : '';
        })();
    </script>
    <link rel="stylesheet" runat="server" href="~/Content/AppTheme.css" />
    <style>
        /* Kept minimal and inline so core theme variables are available
           immediately (before AppTheme.css finishes loading) and so the
           dark-mode toggle keeps working exactly as before. */
        :root {
            --bg-color: #F2F6FB;
            --text-color: #16202E;
            --input-bg: #ffffff;
            --input-border: #C7D3E2;
            --link-color: #0B5FBF;
        }
        html.dark-theme {
            --bg-color: #0F1620;
            --text-color: #E8EEF7;
            --input-bg: #1F2A3B;
            --input-border: #3A4A62;
            --link-color: #7FB6FF;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <header class="app-header">
            <div class="app-header__brand">
                <span class="brand-icon" aria-hidden="true">🥤</span>
                <span class="brand-text">
                    <strong>Beverage Store</strong>
                    <span class="brand-sub">Management System</span>
                </span>
            </div>

            <button type="button" class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle dark mode">
                <span class="icon-light" aria-hidden="true">🌙</span>
                <span class="icon-dark" aria-hidden="true">☀️</span>
                <span class="theme-toggle__label">Toggle Theme</span>
            </button>
        </header>

        <main class="app-main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>

        <footer class="app-footer">
            Beverage Store Management System
        </footer>
    </form>

    <script>
        function toggleTheme() {
            var isDark = document.documentElement.className === 'dark-theme';
            var newTheme = isDark ? 'light' : 'dark';
            document.documentElement.className = newTheme === 'dark' ? 'dark-theme' : '';
            localStorage.setItem('theme', newTheme);
        }
    </script>
</body>
</html>
